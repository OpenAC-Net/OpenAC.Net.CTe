<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net48;netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>../OpenAC.Net.CTe/OpenAC.snk</AssemblyOriginatorKeyFile>
    <Version>1.0.0</Version>
    <Description>Geração de DACTE e relatórios de eventos em PDF com PDFsharp.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../OpenAC.Net.CTe/OpenAC.Net.CTe.csproj" />
    <PackageReference Include="PDFsharp" Version="[6.2.4]" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <EmbeddedResource Include="Resources/Fonts/*.ttf" />
    <None Include="Resources/Fonts/LICENSE.txt" Pack="true" PackagePath="licenses/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
